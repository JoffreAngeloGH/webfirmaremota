---
/** Paso 2: tarjeta de acceso; el usuario y la contraseña se escriben (spec 004). Decorativa. */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg data-anim="acceso" class:list={['fr-ilus', className]} viewBox="0 0 200 104" fill="none" aria-hidden="true">
	<rect x="1" y="1" width="198" height="102" rx="12" fill="var(--fr-color-paper)" stroke="var(--fr-color-line)"></rect>
	<!-- Campo usuario -->
	<rect x="14" y="16" width="34" height="4" rx="2" fill="var(--fr-color-line-strong)"></rect>
	<rect x="14" y="25" width="172" height="24" rx="6" fill="var(--fr-color-sheet)" stroke="var(--fr-color-line-strong)"></rect>
	<g data-parte="usuario" fill="var(--fr-color-navy)">
		<rect x="24" y="34.5" width="16" height="5" rx="2.5"></rect>
		<rect x="43" y="34.5" width="30" height="5" rx="2.5"></rect>
	</g>
	<!-- Campo contraseña -->
	<rect x="14" y="58" width="44" height="4" rx="2" fill="var(--fr-color-line-strong)"></rect>
	<rect x="14" y="67" width="172" height="24" rx="6" fill="var(--fr-color-sheet)" stroke="var(--fr-color-line-strong)"></rect>
	<g fill="var(--fr-color-navy)">
		<circle data-parte="clave" cx="28" cy="79" r="3"></circle>
		<circle data-parte="clave" cx="38" cy="79" r="3"></circle>
		<circle data-parte="clave" cx="48" cy="79" r="3"></circle>
		<circle data-parte="clave" cx="58" cy="79" r="3"></circle>
		<circle data-parte="clave" cx="68" cy="79" r="3"></circle>
		<circle data-parte="clave" cx="78" cy="79" r="3"></circle>
	</g>
	<!-- Llave -->
	<g data-parte="llave" stroke="var(--fr-color-girasol)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
		<circle cx="164" cy="79" r="5"></circle>
		<path d="M169 79h10M175 79v4"></path>
	</g>
</svg>
