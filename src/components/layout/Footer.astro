---
import Logotipo from '@/components/brand/Logotipo.astro';
import { site } from '@/config/site';
import { whatsappUrl } from '@/lib/whatsapp';

const year = new Date().getFullYear();
---

<footer class="bg-fr-ink text-white">
	<div class="gs-container grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
		<div>
			<Logotipo tono="dark" class="text-xl" />
			<p class="mt-3 max-w-xs text-sm leading-relaxed text-white/70">
				Firma tus documentos desde la nube, sin descargar ni instalar nada.
			</p>
			<p class="fr-eyebrow mt-6 text-fr-girasol">
				<a href={site.parent.url} class="hover:text-white" target="_blank" rel="noopener noreferrer">{site.parent.tagline}</a>
			</p>
		</div>
		<div>
			<p class="fr-eyebrow m-0 text-white/60">Contacto</p>
			<a
				href={whatsappUrl()}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-3 inline-block font-fr-mono text-sm text-white hover:text-fr-girasol"
			>
				WhatsApp {site.whatsapp.display}
			</a>
		</div>
		<div>
			<p class="fr-eyebrow m-0 text-white/60">Empresa</p>
			<p class="mt-3 text-sm text-white/80">{site.company.legalName}</p>
			<p class="mt-1 font-fr-mono text-sm text-white/80">RUC {site.company.ruc}</p>
		</div>
	</div>
	<div class="border-t border-white/10">
		<p class="gs-container m-0 py-5 font-fr-mono text-xs text-white/60">© {year} {site.name}</p>
	</div>
</footer>
