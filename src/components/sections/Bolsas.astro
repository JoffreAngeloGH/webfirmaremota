---
/**
 * Bolsas de firmas (spec 005 y 006). Agregar una bolsa a la collection la muestra sin tocar código.
 * Con menos de 3 bolsas, las tarjetas van a la izquierda y el medidor de saldo (slot `medidor`) a la derecha desde `md`;
 * con 3 o más, las tarjetas ocupan todo el ancho y el medidor pasa debajo. `data-anim="fichas"` ya viene en FichasFirmas.
 */
import SectionHeading from '@/components/sections/SectionHeading.astro';
import FichasFirmas from '@/components/illustrations/FichasFirmas.astro';
import { buttonVariants } from '@/components/ui/button';

export interface BolsaTarjeta {
	id: string;
	cantidad: number;
	nombre: string;
	precio: string;
	/** "Incluye IGV" */
	nota?: string;
	/** "No vencen" */
	detalle?: string;
	href: string;
}

interface Props {
	id: string;
	titulo: string;
	acento?: string;
	intro?: string;
	bolsas: BolsaTarjeta[];
	ctaLabel: string;
	/** Línea bajo las tarjetas (p. ej. si solo hay una bolsa). */
	pie?: string;
	/** Texto que acompaña al medidor de saldo (slot `medidor`). */
	medidor?: { titulo: string; acento?: string; texto: string };
}
const { id, titulo, acento, intro, bolsas, ctaLabel, pie, medidor } = Astro.props;
const conMedidor = Astro.slots.has('medidor');
const lado = conMedidor && bolsas.length < 3;
---

<section id={id} aria-labelledby={`${id}-titulo`} class="gs-container gs-section-tras-hero">
	<SectionHeading id={`${id}-titulo`} titulo={titulo} acento={acento} intro={intro} />

	<div class:list={['mt-10 grid gap-10', lado && 'md:grid-cols-2 md:items-start md:gap-8 lg:gap-12']}>
		<div>
			<ul data-reveal="stagger" class:list={['m-0 grid list-none gap-6 p-0', !lado && 'md:grid-cols-2 lg:grid-cols-3', lado && bolsas.length > 1 && 'lg:grid-cols-2']}>
				{
					bolsas.map((bolsa) => (
						<li class="flex flex-col rounded-fr-card border border-fr-line bg-fr-sheet p-7 shadow-fr-sheet transition-[translate,box-shadow] duration-500 ease-gs-out hover:-translate-y-1 hover:shadow-fr-lift sm:p-8">
							<FichasFirmas cantidad={bolsa.cantidad} />
							<p class="mt-6 mb-0 font-fr-display text-[2.6rem] leading-none font-extrabold tracking-tight text-fr-navy tabular-nums">
								{bolsa.precio}
							</p>
							{bolsa.nota && <p class="mt-2 mb-0 text-sm text-fr-muted">{bolsa.nota}</p>}
							{bolsa.detalle && (
								<p class="mt-5 mb-0 flex items-center gap-3 border-t border-dashed border-fr-line-strong pt-5 text-sm text-fr-text">
									<svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 shrink-0 text-fr-navy" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
										<path d="M5 12.5l4.5 4.5L19 7.5" />
									</svg>
									{bolsa.detalle}
								</p>
							)}
							<p class="mt-5 mb-0 font-fr-mono text-xs text-fr-muted">{bolsa.nombre}</p>
							<div class="min-h-8 flex-1" aria-hidden="true" />
							<a href={bolsa.href} target="_blank" rel="noopener noreferrer" class={buttonVariants({ className: 'w-full' })}>
								{ctaLabel}
								<span class="sr-only"> {bolsa.nombre}</span>
							</a>
						</li>
					))
				}
			</ul>
			{pie && <p class="mt-6 mb-0 font-fr-mono text-xs text-fr-muted">{pie}</p>}
		</div>

		{
			conMedidor && (
				<div data-reveal class="grid gap-6">
					{medidor && (
						<div>
							<h3 class="m-0 text-2xl font-bold tracking-tight">
								{medidor.titulo}{' '}
								{medidor.acento && <span class="font-fr-serif font-normal tracking-normal text-fr-navy italic">{medidor.acento}</span>}
							</h3>
							<p class="mt-3 mb-0 text-fr-muted">{medidor.texto}</p>
						</div>
					)}
					<slot name="medidor" />
				</div>
			)
		}
	</div>
</section>
