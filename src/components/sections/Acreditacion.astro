---
/**
 * Respaldo: acreditación de la entidad que emite los certificados (spec 007 §2.5).
 * Tres hitos y un sello de texto. El slot `logo` queda libre para el logo de INDECOPI cuando exista el archivo.
 * Los textos llegan por props (viven en config/secciones.ts).
 */
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Sello from '@/components/brand/Sello.astro';

interface Props {
	id: string;
	etiqueta: string;
	titulo: string;
	acento?: string;
	intro: string;
	hitos: { anio: string; texto: string }[];
	sello: { texto: string; titulo: string; subtitulo: string };
}
const { id, etiqueta, titulo, acento, intro, hitos, sello } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-titulo`} class="border-y border-fr-line bg-fr-sheet">
	<div class="gs-container gs-section">
		<div class="grid items-center gap-10 lg:grid-cols-[1fr_auto] lg:gap-16">
			<SectionHeading id={`${id}-titulo`} etiqueta={etiqueta} titulo={titulo} acento={acento} intro={intro} class="max-w-3xl" />

			<div data-reveal class="flex items-center gap-5 rounded-fr-card border border-fr-line bg-fr-paper p-5 sm:p-6">
				<slot name="logo">
					<Sello texto={sello.texto} class="size-24 shrink-0 text-fr-navy" />
				</slot>
				<div>
					<p class="m-0 font-fr-display text-lg leading-tight font-bold text-fr-navy">{sello.titulo}</p>
					<p class="mt-1 mb-0 font-fr-mono text-xs text-fr-muted">{sello.subtitulo}</p>
				</div>
			</div>
		</div>

		<ol data-reveal="stagger" class="mt-12 grid list-none gap-6 p-0 md:grid-cols-3">
			{
				hitos.map((h) => (
					<li class="rounded-fr-card border border-fr-line bg-fr-paper p-6">
						<p class="m-0 flex items-center gap-2 font-fr-mono text-sm text-fr-muted">
							<span aria-hidden="true" class="size-1.5 rounded-full bg-fr-girasol" />
							{h.anio}
						</p>
						<p class="mt-3 mb-0 font-semibold text-fr-navy">{h.texto}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
