---
/** Paso 1: conversación con un asesor por WhatsApp; el asesor "escribe…" (spec 004). Decorativa. */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg data-anim="chat" class:list={['fr-ilus', className]} viewBox="0 0 200 104" fill="none" aria-hidden="true">
	<rect x="1" y="1" width="198" height="102" rx="12" fill="var(--fr-color-paper)" stroke="var(--fr-color-line)"></rect>
	<!-- Cabecera: asesor en línea -->
	<circle cx="20" cy="18" r="8" fill="var(--fr-color-girasol)"></circle>
	<rect x="34" y="12" width="44" height="5" rx="2.5" fill="var(--fr-color-navy)"></rect>
	<rect x="34" y="21" width="26" height="4" rx="2" fill="var(--fr-color-line-strong)"></rect>
	<path d="M10 34h180" stroke="var(--fr-color-line)"></path>
	<!-- Cliente -->
	<g data-parte="burbuja">
		<rect x="96" y="42" width="92" height="20" rx="8" fill="var(--fr-color-navy)"></rect>
		<rect x="106" y="49.5" width="60" height="5" rx="2.5" fill="var(--fr-color-paper)" opacity="0.8"></rect>
	</g>
	<!-- Asesor -->
	<g data-parte="burbuja">
		<rect x="12" y="68" width="104" height="20" rx="8" fill="var(--fr-color-sheet)" stroke="var(--fr-color-line)"></rect>
		<rect x="22" y="75.5" width="72" height="5" rx="2.5" fill="var(--fr-color-navy)" opacity="0.7"></rect>
	</g>
	<!-- Escribiendo… -->
	<g data-parte="escribiendo" class="fr-escribiendo">
		<rect x="124" y="70" width="38" height="16" rx="8" fill="var(--fr-color-sheet)" stroke="var(--fr-color-line)"></rect>
		<circle cx="135" cy="78" r="2.4" fill="var(--fr-color-muted)"></circle>
		<circle cx="143" cy="78" r="2.4" fill="var(--fr-color-muted)"></circle>
		<circle cx="151" cy="78" r="2.4" fill="var(--fr-color-muted)"></circle>
	</g>
</svg>

<style>
	.fr-escribiendo circle {
		animation: fr-escribiendo 1.2s ease-in-out infinite;
	}
	.fr-escribiendo circle:nth-of-type(2) {
		animation-delay: 0.15s;
	}
	.fr-escribiendo circle:nth-of-type(3) {
		animation-delay: 0.3s;
	}
	@keyframes fr-escribiendo {
		0%,
		60%,
		100% {
			transform: translateY(0);
			opacity: 0.5;
		}
		30% {
			transform: translateY(-2.5px);
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.fr-escribiendo circle {
			animation: none;
		}
	}
</style>
