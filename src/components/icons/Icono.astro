---
/** Íconos lineales en línea (SVG, `currentColor`). Decorativos: `aria-hidden`. Usados por los requisitos (spec 006). */
import { ICONOS, type NombreIcono } from '@/lib/iconos';
interface Props {
	nombre: NombreIcono;
	class?: string;
}
const { nombre, class: className } = Astro.props;
---

<svg
	aria-hidden="true"
	viewBox="0 0 24 24"
	class={className}
	fill="none"
	stroke="currentColor"
	stroke-width="1.7"
	stroke-linecap="round"
	stroke-linejoin="round"
	set:html={ICONOS[nombre]}
/>
