---
import SectionHeading from '@/components/sections/SectionHeading.astro';
import FichasFirmas from '@/components/illustrations/FichasFirmas.astro';
import CertificadoPlanes, { type PlanCertificado } from '@/components/islands/CertificadoPlanes';
import { buttonVariants } from '@/components/ui/button';

export interface PiezaCertificado {
	numero: string;
	etiqueta: string;
	titulo: string;
	nota?: string;
	puntos: string[];
	ctaLabel: string;
	enlace?: { label: string; href: string };
	planes: PlanCertificado[];
	leyendaTitular: string;
	leyendaVigencia: string;
	titulares: { value: PlanCertificado['titular']; label: string }[];
	vigencias: { value: number; label: string }[];
}
export interface PiezaFirmas {
	numero: string;
	etiqueta: string;
	titulo: string;
	precio: string;
	cantidad: number;
	nota?: string;
	puntos: string[];
	cta: { label: string; href: string };
	enlace?: { label: string; href: string };
}
interface Props {
	id: string;
	etiqueta: string;
	titulo: string;
	acento?: string;
	intro?: string;
	certificado: PiezaCertificado;
	firmas: PiezaFirmas;
}
const { id, etiqueta, titulo, acento, intro, certificado, firmas } = Astro.props;
const tarjeta =
	'flex flex-col rounded-fr-card border border-fr-line bg-fr-sheet p-7 shadow-fr-sheet transition-[translate,box-shadow] duration-500 ease-gs-out hover:-translate-y-1 hover:shadow-fr-lift sm:p-8';
---

<section id={id} aria-labelledby={`${id}-titulo`} class="border-y border-fr-line bg-fr-paper-2">
	<div class="gs-container gs-section">
		<SectionHeading id={`${id}-titulo`} etiqueta={etiqueta} titulo={titulo} acento={acento} intro={intro} />

		<ul data-reveal="stagger" class="mt-12 grid list-none gap-6 p-0 md:grid-cols-2">
			<!-- Certificado: 2 titulares × 3 vigencias (isla) -->
			<li class={tarjeta}>
				<CertificadoPlanes client:visible {...certificado} />
			</li>

			<!-- Firmas -->
			<li class={tarjeta}>
				<div class="flex items-center justify-between gap-3">
					<p class="fr-eyebrow m-0 text-fr-muted">{firmas.numero} · {firmas.etiqueta}</p>
					{firmas.nota && <span class="shrink-0 font-fr-mono text-xs whitespace-nowrap text-fr-muted">{firmas.nota}</span>}
				</div>
				<h3 class="mt-5 mb-0 text-2xl font-bold tracking-tight">{firmas.titulo}</h3>
				<FichasFirmas cantidad={firmas.cantidad} class="mt-6" />
				<p class="mt-6 mb-0 font-fr-display text-[2.6rem] leading-none font-extrabold tracking-tight text-fr-navy tabular-nums">
					{firmas.precio}
				</p>
				<ul class="mt-6 mb-0 list-none space-y-3 border-t border-dashed border-fr-line-strong p-0 pt-6">
					{
						firmas.puntos.map((punto) => (
							<li class="flex gap-3 text-sm text-fr-text">
								<svg aria-hidden="true" viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-fr-navy" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
								{punto}
							</li>
						))
					}
				</ul>
				<div class="min-h-8 flex-1" aria-hidden="true"></div>
				<a href={firmas.cta.href} target="_blank" rel="noopener noreferrer" class={buttonVariants({ className: 'w-full' })}>
					{firmas.cta.label}
				</a>
				{firmas.enlace && (
					<a href={firmas.enlace.href} class={buttonVariants({ variant: 'link', className: 'mt-1 self-center' })}>
						{firmas.enlace.label}
					</a>
				)}
			</li>
		</ul>
	</div>
</section>
