---
/** Paso 3: PIN + código OTP y el documento firmado (spec 004). Decorativa. */
import FirmaMini from '@/components/brand/FirmaMini.astro';
interface Props {
	class?: string;
	digitos?: string;
}
const { class: className, digitos = '4821' } = Astro.props;
---

<svg data-anim="paso-firma" class:list={['fr-ilus', className]} viewBox="0 0 200 104" fill="none" aria-hidden="true">
	<rect x="1" y="1" width="198" height="102" rx="12" fill="var(--fr-color-paper)" stroke="var(--fr-color-line)"></rect>
	<!-- PIN -->
	<g fill="var(--fr-color-navy)">
		<circle data-parte="pin" cx="22" cy="24" r="3.5"></circle>
		<circle data-parte="pin" cx="32" cy="24" r="3.5"></circle>
		<circle data-parte="pin" cx="42" cy="24" r="3.5"></circle>
		<circle data-parte="pin" cx="52" cy="24" r="3.5"></circle>
	</g>
	<!-- Código OTP -->
	{
		digitos.split('').map((d, i) => (
			<g data-parte="digito" transform={`translate(${14 + i * 26} 40)`}>
				<rect width="22" height="28" rx="5" fill="var(--fr-color-sheet)" stroke="var(--fr-color-line-strong)" />
				<text x="11" y="19.5" text-anchor="middle" font-size="14" fill="var(--fr-color-navy)" style="font-family: var(--fr-font-mono)">
					{d}
				</text>
			</g>
		))
	}
	<!-- Documento firmado -->
	<g data-parte="doc">
		<rect x="128" y="14" width="56" height="74" rx="5" fill="var(--fr-color-sheet)" stroke="var(--fr-color-navy)" stroke-width="1.8"></rect>
		<path d="M137 26h38M137 33h38M137 40h26" stroke="var(--fr-color-line-strong)" stroke-width="2.4" stroke-linecap="round"></path>
		<FirmaMini x={135} y={52} ancho={42} grosor={3} />
		<path d="M137 74h38" stroke="var(--fr-color-girasol)" stroke-width="1.6" stroke-linecap="round"></path>
	</g>
	<g data-parte="sello">
		<circle cx="182" cy="84" r="11" fill="var(--fr-color-girasol)"></circle>
		<path data-parte="check" pathLength="1" stroke-dasharray="1" stroke-dashoffset="0" d="M177 84l4 4 6-7" stroke="var(--fr-color-navy)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
	</g>
	<path d="M116 54h8" stroke="var(--fr-color-line-strong)" stroke-width="2" stroke-linecap="round" stroke-dasharray="2 3"></path>
</svg>
