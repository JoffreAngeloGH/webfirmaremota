---
import SectionHeading from '@/components/sections/SectionHeading.astro';
import CertificadoPlanes, { type PlanCertificado, type TitularCertificado } from '@/components/islands/CertificadoPlanes';
import FirmasBolsas, { type BolsaFirmas } from '@/components/islands/FirmasBolsas';
import CompraConjunta, { type PropsCompraConjunta } from '@/components/islands/CompraConjunta';

import type { NombreIcono } from '@/lib/iconos';

export interface PiezaCertificado {
	icono: NombreIcono;
	titulo: string;
	lema: string;
	bajada: string;
	/** "+ IGV": va en la misma línea que el precio. */
	nota?: string;
	/** Lo mismo para lectores de pantalla ("más IGV"). */
	notaSr?: string;
	ctaLabel: string;
	planes: PlanCertificado[];
	leyendaTitular: string;
	leyendaVigencia: string;
	titulares: TitularCertificado[];
	vigencias: { value: number; label: string; chip?: string }[];
}
export interface PiezaFirmas {
	icono: NombreIcono;
	titulo: string;
	lema: string;
	bajada: string;
	/** Texto del grupo de bolsas (legend). */
	leyenda: string;
	simbolo: string;
	nota?: string;
	notaSr?: string;
	bolsas: BolsaFirmas[];
	puntos: string[];
	enlace: { label: string; href: string };
}
interface Props {
	id: string;
	etiqueta: string;
	titulo: string;
	acento?: string;
	intro?: string;
	certificado: PiezaCertificado;
	firmas: PiezaFirmas;
	conjunta: PropsCompraConjunta;
}
const { id, etiqueta, titulo, acento, intro, certificado, firmas, conjunta } = Astro.props;
const tarjeta =
	'overflow-hidden rounded-fr-card border border-fr-line bg-fr-sheet shadow-fr-sheet transition-shadow duration-500 ease-gs-out hover:shadow-fr-lift';
---

<section id={id} aria-labelledby={`${id}-titulo`} class="border-y border-fr-line bg-fr-paper-2">
	<div class="gs-container gs-section">
		<SectionHeading id={`${id}-titulo`} etiqueta={etiqueta} titulo={titulo} acento={acento} intro={intro} />

		<ul data-reveal="stagger" class="mt-12 grid list-none gap-6 p-0">
			<!-- Certificado: 2 titulares × 2 vigencias (isla) -->
			<li class={tarjeta}>
				<CertificadoPlanes client:visible {...certificado} />
			</li>

			<!-- Signo "+": une las dos piezas. Decorativo, no es un control. -->
			<li aria-hidden="true" class="pointer-events-none flex h-0 items-center justify-center">
				<span class="relative z-10 grid size-10 shrink-0 place-items-center rounded-full border border-fr-line bg-fr-sheet text-xl leading-none font-semibold text-fr-navy shadow-fr-sheet">+</span>
			</li>

			<!-- Firmas: bolsas seleccionables (isla) -->
			<li class={tarjeta}>
				<FirmasBolsas client:visible {...firmas} />
			</li>

			<!-- Signo "=": las dos piezas juntas dan la compra conjunta. Decorativo, no es un control. -->
			<li aria-hidden="true" class="pointer-events-none flex h-0 items-center justify-center">
				<span class="relative z-10 grid size-10 shrink-0 place-items-center rounded-full border border-fr-line bg-fr-sheet text-xl leading-none font-semibold text-fr-navy shadow-fr-sheet">=</span>
			</li>

			<!-- Compra los dos: suma lo elegido en las dos tarjetas (isla) -->
			<li>
				<CompraConjunta client:visible {...conjunta} />
			</li>
		</ul>
	</div>
</section>
