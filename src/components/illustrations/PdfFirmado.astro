---
/**
 * Dibujo de un PDF firmado (spec 012): el documento con líneas de texto simuladas y un panel de firma. Es decorativo
 * (`aria-hidden`): lo que dice también está en el texto de la sección. Todos los datos del ejemplo son ficticios y
 * llegan por props (vienen de la collection `titulares`). Desde `lg` va girado -1.5° y se endereza al pasar el cursor
 * (sin giro con `prefers-reduced-motion`); en móvil no gira y la nota va debajo del PDF.
 */

interface Props {
	documento: string;
	pagina: string;
	firmadoPor: string;
	nombre: string;
	datos: string;
	validez: string;
	nota: { antes: string; destacado: string; despues: string };
	class?: string;
}
const { documento, pagina, firmadoPor, nombre, datos, validez, nota, class: className } = Astro.props;
// Anchos de las líneas de texto simuladas (decorativos).
const lineas = ['w-full', 'w-[94%]', 'w-full', 'w-[88%]', 'w-[60%]'];
const lineasBajas = ['w-full', 'w-[72%]'];
---

<div aria-hidden="true" class:list={['relative mx-auto w-full max-w-[460px]', className]}>
	<div class="rounded-fr-card border border-fr-line bg-fr-sheet p-5 shadow-fr-lift transition-transform duration-500 ease-gs-out sm:p-6 motion-safe:lg:-rotate-[1.5deg] motion-safe:lg:hover:rotate-0">
		<div class="flex items-center justify-between gap-3 border-b border-fr-line pb-3">
			<p class="m-0 truncate font-fr-mono text-xs text-fr-navy">{documento}</p>
			<p class="m-0 shrink-0 font-fr-mono text-xs text-fr-muted">{pagina}</p>
		</div>

		<div class="mt-5 space-y-2.5">
			{lineas.map((w) => <div class:list={['h-2 rounded-full bg-fr-paper-2', w]} />)}
		</div>
		<div class="mt-5 space-y-2.5">
			{lineasBajas.map((w) => <div class:list={['h-2 rounded-full bg-fr-paper-2', w]} />)}
		</div>

		<div class="mt-6 rounded-fr-control border border-fr-line-strong bg-fr-paper p-4">
			<p class="m-0 font-fr-mono text-[11px] tracking-wide text-fr-muted uppercase">{firmadoPor}</p>
			<p class="mt-1.5 mb-0 font-fr-serif text-[1.7rem] leading-none text-fr-navy italic">{nombre}</p>
			<p class="mt-2 mb-0 font-fr-mono text-[11px] leading-snug text-fr-muted">{datos}</p>
			<p class="mt-3 mb-0 flex items-center gap-2 text-[13px] font-semibold text-fr-navy">
				<span class="grid size-5 shrink-0 place-items-center rounded-full bg-fr-navy text-white">
					<svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
				</span>
				{validez}
			</p>
		</div>
	</div>

	<!-- Nota: debajo del PDF en móvil; montada sobre la esquina inferior derecha desde lg. -->
	<p class="relative mt-4 mb-0 rounded-fr-control bg-fr-navy px-4 py-3 text-sm leading-snug text-white shadow-fr-lift lg:absolute lg:right-[-1.5rem] lg:bottom-[-1.75rem] lg:mt-0 lg:max-w-[260px]">
		{nota.antes}<strong class="font-bold">{nota.destacado}</strong>{nota.despues}
	</p>
</div>
