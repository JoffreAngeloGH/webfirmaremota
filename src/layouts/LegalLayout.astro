---
/**
 * Página legal (spec 007): migas, h1, fecha, botón de PDF opcional, índice con anclas (lateral desde `lg`,
 * plegable en móvil) y el texto en una columna de ~70 caracteres (.fr-prosa). Es indexable.
 */
import type { MarkdownHeading } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import { buttonVariants } from '@/components/ui/button';
import { breadcrumbSchema } from '@/lib/seo/schema';

interface Props {
	titulo: string;
	tituloSeo?: string;
	descripcion: string;
	ruta: string;
	actualizado: Date;
	fuente?: string;
	version?: string;
	pdf?: string;
	headings: MarkdownHeading[];
}
const { titulo, tituloSeo, descripcion, ruta, actualizado, fuente, version, pdf, headings } = Astro.props;
const indice = headings.filter((h) => h.depth === 2);
const fecha = actualizado.toLocaleDateString('es-PE', { dateStyle: 'long', timeZone: 'UTC' });
const enlaceIndice = 'block rounded-sm py-1.5 text-sm text-fr-muted hover:text-fr-tinta';
---

<BaseLayout
	title={tituloSeo ?? titulo}
	description={descripcion}
	schema={[breadcrumbSchema([{ name: 'Inicio', path: '/' }, { name: titulo, path: ruta }])]}
>
	<Header />

	<main>
		<section class="bg-fr-grid">
			<div class="gs-container pt-6 pb-10 md:pb-14">
				<Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: titulo }]} label="Migas de pan" />
				<h1 class="mt-8 mb-0 text-[2.2rem] leading-[1.06] font-extrabold tracking-[-0.03em] sm:text-[3rem] md:mt-12">{titulo}</h1>
				<p class="mt-4 mb-0 font-fr-mono text-xs text-fr-muted">
					Actualizado el {fecha}
					{version && <> · Versión {version}</>}
				</p>
				{
					fuente && (
						<p class="mt-1 mb-0 font-fr-mono text-xs text-fr-muted">
							Fuente: <a href={fuente} class="hover:text-fr-tinta hover:underline" target="_blank" rel="noopener noreferrer">{fuente}</a>
						</p>
					)
				}
				{
					pdf && (
						<a href={pdf} download class={buttonVariants({ variant: 'outline', className: 'mt-6' })}>
							Descargar PDF oficial (firmado)
						</a>
					)
				}
			</div>
		</section>

		<div class="gs-container grid grid-cols-[minmax(0,1fr)] gap-8 pb-20 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-16">
			<aside class="lg:sticky lg:top-28 lg:self-start">
				<details class="rounded-fr-card border border-fr-line bg-fr-sheet px-5 py-3 lg:hidden">
					<summary class="flex min-h-12 cursor-pointer items-center font-semibold text-fr-navy">Contenido</summary>
					<nav aria-label="Contenido de la página">
						<ul class="m-0 list-none p-0 pb-2">
							{indice.map((h) => <li><a href={`#${h.slug}`} class={enlaceIndice}>{h.text}</a></li>)}
						</ul>
					</nav>
				</details>
				<nav aria-label="Contenido de la página" class="hidden lg:block">
					<p class="fr-eyebrow mb-3 text-fr-muted">Contenido</p>
					<ul class="m-0 list-none border-l border-fr-line p-0 pl-4">
						{indice.map((h) => <li><a href={`#${h.slug}`} class={enlaceIndice}>{h.text}</a></li>)}
					</ul>
				</nav>
			</aside>

			<article class="fr-prosa">
				<slot />
			</article>
		</div>
	</main>

	<Footer />
</BaseLayout>
