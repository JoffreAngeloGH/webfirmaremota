---
// /certificado-digital/persona-natural/ y /certificado-digital/persona-juridica/ (spec 008). Los textos de cada
// titular viven en la collection `titulares` (adaptados de girasol.pe); precios, planes, requisitos y preguntas
// salen de las demás collections. Compra solo por WhatsApp.
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ProductoHero from '@/components/sections/ProductoHero.astro';
import CredencialDigital from '@/components/illustrations/CredencialDigital.astro';
import PlanesVigencia from '@/components/sections/PlanesVigencia.astro';
import ParaQueSirve from '@/components/sections/ParaQueSirve.astro';
import Requisitos from '@/components/sections/Requisitos.astro';
import Respaldo from '@/components/sections/Respaldo.astro';
import AntesDeComprar from '@/components/sections/AntesDeComprar.astro';
import Preguntas from '@/components/sections/Preguntas.astro';
import CtaCierre from '@/components/sections/CtaCierre.astro';
import { site } from '@/config/site';
import {
	acreditacion,
	antesDeComprar,
	ctaCierre,
	escribenos,
	mediosPago,
	notaAtencion,
	planesTitular,
	preguntas,
	recorridoRequisitos,
	respaldoTitular,
	verPlanes,
} from '@/config/secciones';
import { getFaqs } from '@/lib/faqs';
import { ahorroDe } from '@/lib/bolsas';
import { formatPrice, notaIgv, rellenar, titularLabel, vigenciaLabel } from '@/lib/format';
import { precioPorAnio, vigenciasTexto } from '@/lib/planes';
import { productWhatsappUrl } from '@/lib/whatsapp';
import { whatsappUrl } from '@/lib/whatsapp';
import { breadcrumbSchema, faqSchema, productSchema } from '@/lib/seo/schema';

export async function getStaticPaths() {
	const titulares = await getCollection('titulares');
	return titulares.map((t) => ({ params: { titular: t.data.slug }, props: { datos: t.data } }));
}

const { datos } = Astro.props;
const ruta = `/certificado-digital/${datos.slug}/`;

const productos = (await getCollection('productos')).map((p) => p.data).sort((a, b) => a.orden - b.orden);
const todos = productos.flatMap((p) => (p.tipo === 'certificado' ? [p] : []));
const planes = todos.filter((p) => p.titular === datos.titular);
const vigencias = [...new Set(planes.map((p) => p.vigenciaAnios))].sort();
const desde = planes.reduce((min, p) => (p.precio < min.precio ? p : min));
const desdeTexto = formatPrice(desde.precio, desde.moneda);

const requisitos = (await getCollection('requisitos')).map((r) => r.data).find((r) => r.titular === datos.titular)!;
const faqs = await getFaqs(datos.slug as 'persona-natural' | 'persona-juridica');
const { devolucion, entrega } = datos.antesDeComprar;

// Una tarjeta de vigencia por plan del titular: meses, ahorro y precio por año se calculan de la collection.
const base = planes.find((p) => p.vigenciaAnios === vigencias[0])!;
const maxMeses = Math.max(...vigencias) * 12;
const planesVigencia = vigencias.map((anios) => {
	const p = planes.find((x) => x.vigenciaAnios === anios)!;
	const ahorro = ahorroDe(p.precio / anios, base.precio / vigencias[0]!);
	const destacado = anios === 2;
	return {
		id: `${datos.slug}-${anios}-${anios === 1 ? 'ano' : 'anos'}`,
		titulo: vigenciaLabel(anios),
		anios,
		meses: anios * 12,
		mesesTexto: rellenar(planesTitular.mesesLabel, { n: anios * 12 }),
		precio: formatPrice(p.precio, p.moneda),
		nota: notaIgv(p.incluyeIgv),
		lineaBajo: rellenar(anios > 1 ? planesTitular.lineaVariosAnios : planesTitular.lineaUnAnio, { precio: precioPorAnio(p.precio, anios, p.moneda) }),
		destacado: destacado ? planesTitular.masElegido : undefined,
		ahorro: ahorro > 0 ? rellenar(planesTitular.ahorraLabel, { n: ahorro }) : undefined,
		ctaLabel: rellenar(planesTitular.ctaLabel, { vigencia: vigenciaLabel(anios) }),
		nombre: p.nombre,
		href: productWhatsappUrl(p),
		principal: destacado,
	};
});
const escala = {
	meses: maxMeses,
	rotulos: [{ texto: planesTitular.hoy, meses: 0 }, ...vigencias.map((a) => ({ texto: rellenar(planesTitular.mesesLabel, { n: a * 12 }), meses: a * 12 }))],
};

// El h1 se parte en "Certificado digital" + "para …" (la segunda parte va en serif).
const corte = datos.h1.indexOf(' para ');
const tituloH1 = datos.h1.slice(0, corte);
const acentoH1 = datos.h1.slice(corte + 1);

const migas = [{ label: 'Inicio', href: '/' }, { label: 'Certificado digital', href: '/certificado-digital/' }, { label: datos.nombre }];
const chips = [vigenciasTexto(vigencias), `Desde ${desdeTexto} ${notaIgv(desde.incluyeIgv)}`, 'Entrega aprox. 1 hora'];
const comprar = { label: ctaCierre.ctaLabel, href: whatsappUrl() };
---

<BaseLayout
	title={datos.seo.title}
	description={datos.seo.description.replace('{desde}', desdeTexto)}
	schema={[
		...planes.map((p) => productSchema(p, ruta)),
		breadcrumbSchema([
			{ name: 'Inicio', path: '/' },
			{ name: 'Certificado digital', path: '/certificado-digital/' },
			{ name: datos.nombre, path: ruta },
		]),
		faqSchema(faqs.map((f) => ({ question: f.pregunta, answer: f.respuesta }))),
	]}
>
	<Header />

	<main>
		<ProductoHero
			migas={migas}
			migasLabel="Migas de pan"
			etiqueta="Certificado digital"
			titulo={tituloH1}
			acento={acentoH1}
			subtitulo={datos.descripcion}
			nota={notaAtencion}
			chips={chips}
			ctas={[
				{ label: verPlanes, href: '#planes' },
				{ label: escribenos, href: whatsappUrl(), externo: true },
			]}
		>
			<CredencialDigital adelante={datos.titular} />
		</ProductoHero>

		<PlanesVigencia
			id={planesTitular.id}
			etiqueta={planesTitular.etiqueta}
			titulo={planesTitular.titulo}
			acento={planesTitular.acento}
			intro={rellenar(planesTitular.intro, { titular: titularLabel[datos.titular] })}
			planes={planesVigencia}
			escala={escala}
		/>

		<ParaQueSirve id="para-que-sirve" {...datos.paraQueSirve} usos={[...datos.paraQueSirve.usos]} validoPara={datos.paraQueSirve.validoPara && [...datos.paraQueSirve.validoPara]} />

		<Requisitos
			id="requisitos"
			etiqueta={recorridoRequisitos.etiqueta}
			titulo={recorridoRequisitos.titulo}
			acento={recorridoRequisitos.acento}
			intro={requisitos.intro}
			pasos={requisitos.items}
			final={{ icono: recorridoRequisitos.final.icono, destacado: entrega.destacado, resto: recorridoRequisitos.final.resto, texto: recorridoRequisitos.final.texto }}
			nota={recorridoRequisitos.nota}
		/>

		<!-- P22: logo de INDECOPI en el sello cuando llegue el archivo (specs/pendientes.md) -->
		<Respaldo
			id={respaldoTitular.id}
			etiqueta={respaldoTitular.etiqueta}
			titulo={respaldoTitular.titulo}
			acento={respaldoTitular.acento}
			intro={acreditacion.intro}
			selloTexto={acreditacion.sello.texto}
			enlace={{ label: respaldoTitular.enlaceLabel, href: site.rops }}
			hitos={acreditacion.hitos.map((h) => ({ anio: h.anio, titulo: h.titulo, detalle: h.detalle }))}
		/>

		<AntesDeComprar
			id={antesDeComprar.id}
			etiqueta={antesDeComprar.etiqueta}
			titulo={antesDeComprar.titulo}
			acento={antesDeComprar.acento}
			intro={antesDeComprar.intro}
			devolucion={{
				...devolucion,
				correos: devolucion.correos,
				enlace: { label: devolucion.enlace, href: '/terminos-y-condiciones/#política-devolución-de-pago-realizado' },
			}}
			pagos={{
				titulo: antesDeComprar.pagos.titulo,
				texto: antesDeComprar.pagos.texto,
				medios: mediosPago.medios.map((nombre, i) => ({ nombre, monograma: antesDeComprar.pagos.monogramas[i] ?? nombre.slice(0, 2).toUpperCase() })),
			}}
		/>

		<Preguntas {...preguntas} faqs={faqs} />

		<CtaCierre
			id={ctaCierre.id}
			titulo={ctaCierre.titulo}
			acento={ctaCierre.acento}
			texto={ctaCierre.texto}
			cta={comprar}
			ctaSecundario={{ label: ctaCierre.ctaSecundarioLabel, href: whatsappUrl() }}
		/>
	</main>

	<Footer />
</BaseLayout>
