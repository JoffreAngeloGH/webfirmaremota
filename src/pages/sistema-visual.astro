---
// Página interna del equipo (spec 003 §3): muestra de la identidad "Tinta digital".
// Siempre noindex y fuera del sitemap (astro.config → sitemap filter).
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Firma from '@/components/brand/Firma.astro';
import Sello from '@/components/brand/Sello.astro';
import LineaFirma from '@/components/brand/LineaFirma.astro';
import CodigoOtp from '@/components/brand/CodigoOtp.astro';
import Logotipo from '@/components/brand/Logotipo.astro';
import { buttonVariants } from '@/components/ui/button';

const colores = [
	{ nombre: 'paper', valor: '#FBFAF7', clase: 'bg-fr-paper', uso: 'Fondo' },
	{ nombre: 'paper-2', valor: '#F3F1EA', clase: 'bg-fr-paper-2', uso: 'Secciones alternas' },
	{ nombre: 'navy', valor: '#0E035C', clase: 'bg-fr-navy', uso: 'Títulos, fondos fuertes' },
	{ nombre: 'ink', valor: '#16151C', clase: 'bg-fr-ink', uso: 'Footer' },
	{ nombre: 'tinta', valor: '#2443D6', clase: 'bg-fr-tinta', uso: 'Solo lo que se pulsa' },
	{ nombre: 'girasol', valor: '#E8A33D', clase: 'bg-fr-girasol', uso: 'Acento decorativo' },
	{ nombre: 'muted', valor: '#555A6E', clase: 'bg-fr-muted', uso: 'Texto secundario' },
];
---

<BaseLayout
	title="Sistema visual"
	description="Muestra interna de la identidad visual de firmaremota.pe."
	noindex
>
	<Header />
	<main>
		<section class="gs-container gs-section">
			<SectionHeading
				etiqueta="Interno · no indexado"
				titulo="Tinta"
				acento="digital."
				intro="Sub-marca derivada de Girasol. Papel y navy de base; azul tinta solo para lo que se pulsa; ámbar girasol como acento. Detalle en specs/features/002-identidad-visual."
			/>

			<h2 class="mt-14 mb-0 text-xl font-bold">Color</h2>
			<ul class="mt-5 grid list-none grid-cols-2 gap-4 p-0 sm:grid-cols-4 lg:grid-cols-7">
				{
					colores.map((c) => (
						<li class="overflow-hidden rounded-fr-control border border-fr-line bg-fr-sheet">
							<div class:list={['h-16 border-b border-fr-line', c.clase]} />
							<div class="p-3">
								<p class="m-0 text-sm font-semibold text-fr-navy">{c.nombre}</p>
								<p class="m-0 font-fr-mono text-xs text-fr-muted">{c.valor}</p>
								<p class="m-0 mt-1 text-xs text-fr-muted">{c.uso}</p>
							</div>
						</li>
					))
				}
			</ul>

			<h2 class="mt-14 mb-0 text-xl font-bold">Tipografía</h2>
			<div class="mt-5 grid gap-4 md:grid-cols-3">
				<div class="rounded-fr-card border border-fr-line bg-fr-sheet p-6">
					<p class="fr-eyebrow m-0 text-fr-muted">Display · Outfit</p>
					<p class="mt-3 mb-0 text-3xl font-extrabold tracking-tight text-fr-navy">Firma segura</p>
				</div>
				<div class="rounded-fr-card border border-fr-line bg-fr-sheet p-6">
					<p class="fr-eyebrow m-0 text-fr-muted">Acento · Instrument Serif</p>
					<p class="mt-3 mb-0 font-fr-serif text-3xl text-fr-navy italic">desde la nube</p>
				</div>
				<div class="rounded-fr-card border border-fr-line bg-fr-sheet p-6">
					<p class="fr-eyebrow m-0 text-fr-muted">Datos · JetBrains Mono</p>
					<p class="mt-3 mb-0 font-fr-mono text-2xl text-fr-navy">PIN + OTP</p>
				</div>
			</div>

			<h2 class="mt-14 mb-0 text-xl font-bold">Botones</h2>
			<div class="mt-5 flex flex-wrap items-center gap-3">
				<a href="#" class={buttonVariants()}>Primario</a>
				<a href="#" class={buttonVariants({ variant: 'outline' })}>Secundario</a>
				<a href="#" class={buttonVariants({ variant: 'navy' })}>Navy</a>
				<a href="#" class={buttonVariants({ size: 'pill' })}>Píldora</a>
				<a href="#" class={buttonVariants({ variant: 'link' })}>Enlace</a>
			</div>
			<div class="mt-4 inline-flex flex-wrap gap-3 rounded-fr-card bg-fr-navy p-4">
				<a href="#" class={buttonVariants()}>Primario</a>
				<a href="#" class={buttonVariants({ variant: 'outline-dark' })}>Secundario oscuro</a>
			</div>

			<h2 class="mt-14 mb-0 text-xl font-bold">Motivos</h2>
			<div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
				<div class="grid place-items-center rounded-fr-card border border-fr-line bg-fr-sheet p-6"><Logotipo class="text-2xl" /></div>
				<div class="rounded-fr-card border border-fr-line bg-fr-sheet p-6">
					<Firma class="w-48 text-fr-navy" />
					<LineaFirma leyenda="Línea de firma" />
				</div>
				<div class="grid place-items-center rounded-fr-card border border-fr-line bg-fr-sheet p-6"><Sello class="size-28 text-fr-girasol" /></div>
				<div class="grid place-items-center rounded-fr-card border border-fr-line bg-fr-sheet p-6"><CodigoOtp /></div>
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>
