---
// /certificado-digital/ (specs 005, 006 y 007): página informativa sobre los dos certificados, sin compra por plan
// (la compra está en el inicio y en las páginas por titular). Los textos viven aquí; requisitos y preguntas salen de
// las collections.
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ProductoHero from '@/components/sections/ProductoHero.astro';
import CertificadosPorTitular from '@/components/sections/CertificadosPorTitular.astro';
import CredencialDigital from '@/components/illustrations/CredencialDigital.astro';
import NecesitasLosDos from '@/components/sections/NecesitasLosDos.astro';
import ComoFunciona from '@/components/sections/ComoFunciona.astro';
import Preguntas from '@/components/sections/Preguntas.astro';
import CtaCierre from '@/components/sections/CtaCierre.astro';
import { comoFunciona, ctaCierre, necesitasLosDos, preguntas } from '@/config/secciones';
import { getFaqs } from '@/lib/faqs';
import { vigenciasTexto } from '@/lib/planes';
import { certificadoTitularUrl, whatsappUrl } from '@/lib/whatsapp';
import { breadcrumbSchema, faqSchema } from '@/lib/seo/schema';

const productos = (await getCollection('productos')).map((p) => p.data).sort((a, b) => a.orden - b.orden);
const planes = productos.flatMap((p) => (p.tipo === 'certificado' ? [p] : []));
const requisitos = (await getCollection('requisitos')).map((r) => r.data).sort((a, b) => a.orden - b.orden);
const datosTitulares = (await getCollection('titulares')).map((t) => t.data);
const faqs = await getFaqs('certificado-digital');

const vigencias = [...new Set(planes.map((p) => p.vigenciaAnios))].sort();
const titulares = ['natural', 'juridica'] as const;
// Textos por titular (P05): qué se puede firmar con cada certificado.
const textosTitular = {
	natural: { titulo: 'Persona natural', linea: 'Firma a tu nombre contratos, solicitudes y cualquier documento PDF, con validez legal.' },
	juridica: {
		titulo: 'Persona jurídica',
		linea: 'Firma contratos, actas y documentos legales como persona jurídica, con plena validez legal ante entidades públicas y privadas. También para personas vinculadas a una empresa.',
	},
} as const;

const description =
	`Certificado digital para firma remota, persona natural o jurídica, de ${vigenciasTexto(vigencias)}. ` +
	`Sin instalar nada. Te atiende un asesor por WhatsApp.`;

const chips = [`${titulares.length} titulares`, `${vigencias.length} vigencias`];
const migas = [{ label: 'Inicio', href: '/' }, { label: 'Certificado digital' }];
const comprar = { label: ctaCierre.ctaLabel, href: whatsappUrl() };
// Una ficha por titular: sus usos salen de `titulares.yaml` y sus requisitos, completos y en su orden, de `requisitos.yaml`.
const iconoTitular = { natural: 'persona', juridica: 'edificio' } as const;
const cortaTitular = { natural: 'A tu nombre', juridica: 'En nombre de tu empresa' } as const;
const etiquetaUsos = { natural: 'Sirve para', juridica: 'Pensado para' } as const;
const fichas = titulares.map((titular) => {
	const datos = datosTitulares.find((d) => d.titular === titular)!;
	const req = requisitos.find((r) => r.titular === titular)!;
	return {
		id: datos.slug,
		icono: iconoTitular[titular],
		nombre: textosTitular[titular].titulo,
		corta: cortaTitular[titular],
		descripcion: textosTitular[titular].linea,
		etiquetaUsos: etiquetaUsos[titular],
		usos: datos.paraQueSirve.usos.map((u) => u.texto),
		cta: { label: 'Consultar por WhatsApp', href: certificadoTitularUrl(titular) },
		enlace: { label: `Ver detalles de ${textosTitular[titular].titulo.toLowerCase()}`, href: `/certificado-digital/${datos.slug}/` },
		requisitosTitulo: 'Lo que necesitas',
		requisitosIntro: req.intro,
		requisitos: req.items,
		nota: 'Un asesor te confirma los requisitos antes de la compra.',
	};
});
---

<BaseLayout
	title="Certificado digital persona natural y jurídica"
	description={description}
	schema={[
		breadcrumbSchema([{ name: 'Inicio', path: '/' }, { name: 'Certificado digital', path: '/certificado-digital/' }]),
		faqSchema(faqs.map((f) => ({ question: f.pregunta, answer: f.respuesta }))),
	]}
>
	<Header />

	<main>
		<ProductoHero
			migas={migas}
			migasLabel="Migas de pan"
			etiqueta="Certificado digital"
			titulo="Certificado digital"
			acento="para firma remota."
			subtitulo="Tu identidad digital vive en la nube: firmas con tu usuario, tu PIN y un código que llega a tu WhatsApp. Hay dos certificados: persona natural y persona jurídica."
			chips={chips}
		>
			<CredencialDigital />
		</ProductoHero>

		<CertificadosPorTitular
			id="cual-necesitas"
			etiqueta="Titulares"
			titulo="¿Cuál"
			acento="necesitas?"
			intro="Elige el tuyo: te mostramos para qué sirve y qué documentos tienes que preparar."
			selectorLabel="Titular del certificado"
			fichas={fichas}
		/>

		<NecesitasLosDos {...necesitasLosDos} enlace={{ label: 'Ver bolsas de firmas', href: '/firmas/' }} />

		<ComoFunciona {...comoFunciona} pasos={[...comoFunciona.pasos]} />

		<Preguntas {...preguntas} faqs={faqs} />

		<CtaCierre
			id={ctaCierre.id}
			titulo={ctaCierre.titulo}
			acento={ctaCierre.acento}
			texto={ctaCierre.texto}
			cta={comprar}
			ctaSecundario={{ label: ctaCierre.ctaSecundarioLabel, href: whatsappUrl() }}
		/>
	</main>

	<Footer />
</BaseLayout>
