---
/**
 * Menú móvil (spec 006 §3.6): botón + panel con el atributo `popover` nativo, sin React.
 * El navegador resuelve Esc, el cierre al tocar fuera y el regreso del foco al botón. El script solo actualiza el
 * texto accesible y cierra el panel al elegir un enlace (un ancla de la misma página no cambia de página).
 * Con ClientRouter, cada página trae su propio header: el panel nace cerrado.
 */
import { buttonVariants } from '@/components/ui/button';

interface Props {
	links: { href: string; label: string }[];
	/** Textos del botón y del panel. */
	abrirLabel: string;
	cerrarLabel: string;
	navLabel: string;
}
const { links, abrirLabel, cerrarLabel, navLabel } = Astro.props;
---

<div class="md:hidden" data-menu-movil data-abrir={abrirLabel} data-cerrar={cerrarLabel}>
	<button
		type="button"
		popovertarget="menu-movil"
		aria-controls="menu-movil"
		aria-expanded="false"
		aria-label={abrirLabel}
		class={buttonVariants({ variant: 'outline', size: 'icon' })}
	>
		<svg aria-hidden="true" viewBox="0 0 24 24" class="fr-menu__abrir size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<path d="M4 7h16M4 12h16M4 17h16" />
		</svg>
		<svg aria-hidden="true" viewBox="0 0 24 24" class="fr-menu__cerrar size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<path d="M6 6l12 12M18 6L6 18" />
		</svg>
	</button>

	<div id="menu-movil" popover="auto" class="fr-menu">
		<nav aria-label={navLabel}>
			<ul class="m-0 list-none p-0">
				{
					links.map((l) => (
						<li class="border-b border-fr-line last:border-b-0">
							<a href={l.href} class="flex min-h-12 items-center px-1 py-2 text-lg font-semibold text-fr-navy hover:text-fr-tinta">
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</div>

<style>
	/* Hoja bajo el header (64px), a todo el ancho. Los estilos de [popover] no los pone Tailwind. */
	.fr-menu {
		position: fixed;
		inset: 4rem 0 auto 0;
		width: 100%;
		max-width: none;
		margin: 0;
		border: 0;
		border-bottom: 1px solid var(--fr-color-line);
		background: var(--fr-color-paper);
		padding: 0.5rem 1rem 1rem;
		box-shadow: 0 18px 30px -18px rgb(14 3 92 / 0.25);
	}
	.fr-menu::backdrop {
		background: rgb(22 21 28 / 0.35);
	}
	.fr-menu__abrir,
	.fr-menu__cerrar {
		grid-area: 1 / 1;
	}
	.fr-menu__cerrar {
		display: none;
	}
	[aria-expanded='true'] .fr-menu__abrir {
		display: none;
	}
	[aria-expanded='true'] .fr-menu__cerrar {
		display: block;
	}
</style>

<script>
	function iniciarMenus() {
		document.querySelectorAll<HTMLElement>('[data-menu-movil]').forEach((raiz) => {
			const boton = raiz.querySelector<HTMLButtonElement>('button[popovertarget]');
			const panel = raiz.querySelector<HTMLElement>('[popover]');
			if (!boton || !panel) return;
			panel.addEventListener('toggle', (e) => {
				const abierto = (e as ToggleEvent).newState === 'open';
				boton.setAttribute('aria-expanded', String(abierto));
				boton.setAttribute('aria-label', (abierto ? raiz.dataset.cerrar : raiz.dataset.abrir) ?? '');
			});
			panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => panel.hidePopover()));
		});
	}
	document.addEventListener('astro:page-load', iniciarMenus);
</script>
