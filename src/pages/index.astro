---
// Inicio (specs 003 y 004). Los textos de cada sección viven aquí y se pasan por props;
// precios, planes, WhatsApp y preguntas salen de los datos.
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Hero from '@/components/sections/Hero.astro';
import Ventajas from '@/components/sections/Ventajas.astro';
import Productos, { type PiezaCertificado, type PiezaFirmas } from '@/components/sections/Productos.astro';
import type { PropsCompraConjunta } from '@/components/islands/CompraConjunta';
import NecesitasLosDos from '@/components/sections/NecesitasLosDos.astro';
import ComoFunciona from '@/components/sections/ComoFunciona.astro';
import Acreditacion from '@/components/sections/Acreditacion.astro';
import Preguntas from '@/components/sections/Preguntas.astro';
import CtaCierre from '@/components/sections/CtaCierre.astro';
import { acreditacion, comoFunciona, ctaCierre, necesitasLosDos, notaAtencion, preguntas } from '@/config/secciones';
import { ahorroDe } from '@/lib/bolsas';
import { getFaqs } from '@/lib/faqs';
import { formatCantidad, formatPrice, notaIgv, notaIgvAccesible, titularLabel, vigenciaLabel } from '@/lib/format';
import { precioPorAnio } from '@/lib/planes';
import { site } from '@/config/site';
import { productWhatsappUrl, whatsappUrl } from '@/lib/whatsapp';
import { faqSchema, serviceSchema } from '@/lib/seo/schema';

const productos = (await getCollection('productos')).map((p) => p.data).sort((a, b) => a.orden - b.orden);
const planes = productos.filter((p) => p.tipo === 'certificado');
const bolsas = productos.flatMap((p) => (p.tipo === 'firmas' ? [p] : []));
const firmas = bolsas[0]!; // la bolsa mínima (orden más bajo)
const vigencias = [...new Set(planes.map((p) => (p.tipo === 'certificado' ? p.vigenciaAnios : 0)))].sort();
const vigenciasTexto = `${vigencias.slice(0, -1).join(', ')} o ${vigencias[vigencias.length - 1]} años`;
const faqs = await getFaqs('inicio');

const puntoPlazo = 'Listo en aprox. 1 hora, después de validar tu identidad';
const puntoNube = 'Vive en la nube: no hay archivo ni token que instalar';

const comprar = { label: 'Comprar', href: whatsappUrl() };

// Certificado: 2 titulares × 2 vigencias (spec 004). Todo sale de la collection.
const certificado: PiezaCertificado = {
	icono: 'identidad',
	titulo: 'Certificado digital',
	lema: 'Tu identidad para firmar.',
	bajada: `Demuestra que el documento lo firmaste tú, o tu empresa, con validez legal. Lo pagas una vez y dura ${vigenciasTexto}.`,
	nota: notaIgv(planes[0]!.incluyeIgv),
	notaSr: notaIgvAccesible(planes[0]!.incluyeIgv),
	ctaLabel: 'Comprar certificado',
	leyendaTitular: '¿A nombre de quién?',
	leyendaVigencia: '¿Por cuánto tiempo?',
	titulares: ([
		{
			value: 'natural' as const,
			icono: 'persona' as const,
			corta: 'A tu nombre',
			puntos: [puntoPlazo, 'Necesitas tu DNI o CE vigente', puntoNube],
			enlace: { label: 'Ver requisitos de persona natural', href: '/certificado-digital/persona-natural/' },
		},
		{
			value: 'juridica' as const,
			icono: 'edificio' as const,
			corta: 'En nombre de tu empresa',
			puntos: [puntoPlazo, 'Necesitas tu DNI o CE, el RUC de la empresa y una vigencia de poder', puntoNube],
			enlace: { label: 'Ver requisitos de persona jurídica', href: '/certificado-digital/persona-juridica/' },
		},
	]).map((t) => ({ ...t, label: titularLabel[t.value].replace(/^persona/, 'Persona') })),
	vigencias: vigencias.map((v) => {
		// Ahorro frente a comprar de a 1 año: se compara el precio por año (misma función que las bolsas).
		const base = planes.find((p) => p.tipo === 'certificado' && p.vigenciaAnios === vigencias[0]);
		const plan = planes.find((p) => p.tipo === 'certificado' && p.vigenciaAnios === v);
		const ahorro = base && plan ? ahorroDe(plan.precio / v, base.precio / vigencias[0]!) : 0;
		return { value: v, label: vigenciaLabel(v), chip: ahorro > 0 ? `Ahorras ${ahorro} %` : undefined };
	}),
	planes: planes.flatMap((p) =>
		p.tipo === 'certificado'
			? [
					{
						id: `${p.titular}-${p.vigenciaAnios}`,
						titular: p.titular,
						vigenciaAnios: p.vigenciaAnios,
						nombre: p.nombre,
						precio: p.precio,
						precioTexto: formatPrice(p.precio, p.moneda),
						simbolo: formatPrice(0, p.moneda).split(' ')[0]!,
						lineaCorta: `${titularLabel[p.titular].replace(/^persona/, 'Persona')} · ${vigenciaLabel(p.vigenciaAnios)}`,
						lineaBajo:
							p.vigenciaAnios > 1
								? `Equivale a ${precioPorAnio(p.precio, p.vigenciaAnios, p.moneda)} por año.`
								: 'Un solo pago por toda la vigencia.',
						href: productWhatsappUrl(p),
					},
				]
			: [],
	),
};

// Bolsas seleccionables: las cantidades se eligen aquí; precio, ahorro y formato salen de la collection.
const bolsasElegidas = ([10, 1000, 20000] as const).map((cantidad) => {
	const b = bolsas.find((x) => x.cantidad === cantidad);
	if (!b) throw new Error(`Bolsas de firmas: no existe la bolsa de ${cantidad} firmas en productos.yaml`);
	return b;
});
const unitarioMinimo = firmas.precioUnitario; // la bolsa mínima, igual que en /firmas/

const piezaFirmas: PiezaFirmas = {
	icono: 'contrato',
	titulo: 'Firmas',
	lema: 'El saldo que usas al firmar.',
	bajada: 'Cada vez que firmas un documento se descuenta 1 firma de tu bolsa. Si un documento lleva 3 firmas, se descuentan 3.',
	leyenda: 'Mientras más compras, menos pagas por firma',
	simbolo: formatPrice(0, firmas.moneda).split(' ')[0]!,
	nota: notaIgv(firmas.incluyeIgv),
	notaSr: notaIgvAccesible(firmas.incluyeIgv),
	bolsas: bolsasElegidas.map((b) => {
		const ahorro = ahorroDe(b.precioUnitario, unitarioMinimo);
		return {
			id: String(b.cantidad),
			cantidadTexto: `${formatCantidad(b.cantidad)} firmas`,
			total: b.precio,
			totalTexto: formatPrice(b.precio, b.moneda),
			unitarioTexto: `${formatPrice(b.precioUnitario, b.moneda)} c/u`,
			ahorroTexto: ahorro > 0 ? `Ahorras ${ahorro} %` : undefined,
			lineaPlan: `Bolsa de ${formatCantidad(b.cantidad)} firmas`,
			lineaBajo: `${formatPrice(b.precioUnitario, b.moneda)} por firma · no vencen.`,
			ctaLabel: `Comprar ${formatCantidad(b.cantidad)} firmas`,
			href: productWhatsappUrl(b),
		};
	}),
	puntos: [
		'Las firmas no vencen: las usas a tu ritmo',
		'Funcionan con tu certificado, aunque sea de otro proveedor',
		'Si también compras tu certificado aquí, un mismo asesor te ayuda con los dos',
	],
	enlace: { label: `Ver las ${bolsas.length} bolsas de firmas`, href: '/firmas/' },
};

// Compra conjunta: suma el plan y la bolsa elegidos en las tarjetas; el mensaje se arma en la isla con esta plantilla.
const conjunta: PropsCompraConjunta = {
	titulo: '¿Necesitas los dos? Pídelos juntos',
	planes: planes.flatMap((p) =>
		p.tipo === 'certificado'
			? [
					{
						id: `${p.titular}-${p.vigenciaAnios}`,
						titular: titularLabel[p.titular],
						vigencia: vigenciaLabel(p.vigenciaAnios),
						precioTexto: formatPrice(p.precio, p.moneda),
						resumen: `Certificado ${titularLabel[p.titular]} · ${vigenciaLabel(p.vigenciaAnios)}`,
					},
				]
			: [],
	),
	bolsas: bolsasElegidas.map((b) => ({
		id: String(b.cantidad),
		cantidad: b.cantidad,
		precioTexto: formatPrice(b.precio, b.moneda),
		resumen: `Bolsa de ${formatCantidad(b.cantidad)} firmas`,
		resumenSr: `bolsa de ${formatCantidad(b.cantidad)} firmas`,
	})),
	union: '+',
	ctaLabel: 'Comprar los dos',
	anuncio: '{plan} y {bolsa}',
	plantilla: site.whatsappMessages.combo,
	urlBase: `https://wa.me/${site.whatsapp.number}?text=`,
};

const description =
	`Firma digital en la nube, sin descargar ni instalar nada. Certificado digital para persona natural y jurídica ` +
	`y firmas desde ${formatPrice(firmas.precio, firmas.moneda, 0)}. Te atendemos por WhatsApp.`;

---

<BaseLayout
	title="Firma remota: firma tus documentos desde la nube | firmaremota.pe"
	titleAbsolute
	description={description}
	schema={[serviceSchema(productos, '/'), faqSchema(faqs.map((f) => ({ question: f.pregunta, answer: f.respuesta })))]}
>
	<Header />

	<main>
		<Hero
			etiqueta="Firma remota · Perú"
			titulo="Firma tus documentos"
			acento="desde la nube."
			subtitulo="Sin descargar ni instalar nada. Entras con tu usuario, confirmas con tu PIN y un código que llega a tu WhatsApp."
			nota={notaAtencion}
			cta={{ ...comprar, externo: true }}
			ctaSecundario={{ label: 'Cómo funciona', href: '#como-funciona' }}
		/>

		<Ventajas
			id="ventajas"
			etiqueta="Qué es"
			titulo="Tu firma,"
			acento="sin instalar nada."
			ventajas={[
				{ ilustracion: 'sin-instalar', titulo: 'Sin instalar nada', texto: 'No hay archivos, programas ni token. Tu certificado vive en la nube.' },
				{ ilustracion: 'dispositivos', titulo: 'Desde donde estés', texto: 'Firmas con tu usuario y contraseña, desde cualquier lugar con internet.' },
				{ ilustracion: 'verificacion', titulo: 'Doble verificación', texto: 'Cada firma se confirma con tu PIN y un código que llega a tu WhatsApp.' },
			]}
			comparacion={{
				caption: 'Comparación entre el certificado tradicional y la firma remota',
				columnas: ['Certificado tradicional', 'Firma remota'],
				filas: [
					{ label: 'Dónde está', a: 'En un archivo instalado o en tu equipo local o token', b: 'En la nube' },
					{ label: 'Qué necesitas', a: 'La computadora o el token donde está instalado', b: 'Usuario, PIN y tu WhatsApp' },
					{ label: 'Para empezar', a: 'Descargar, instalar y configurar', b: 'Recibes tu acceso y listo' },
				],
			}}
		/>

		<Productos
			id="productos"
			etiqueta="Productos"
			titulo="Dos piezas,"
			acento="una firma."
			intro="El certificado es tu identidad: dice quién firma. Las firmas son el saldo para usarla: cada vez que firmas, se descuenta una. Se compran por separado y necesitas los dos."
			certificado={certificado}
			firmas={piezaFirmas}
				conjunta={conjunta}
		/>

		<NecesitasLosDos {...necesitasLosDos} />

		<ComoFunciona {...comoFunciona} pasos={[...comoFunciona.pasos]} />

		<!-- P22: logo de INDECOPI en el slot `logo` cuando llegue el archivo (specs/pendientes.md) -->
		<Acreditacion {...acreditacion} hitos={[...acreditacion.hitos]} sello={{ ...acreditacion.sello }} />

		<Preguntas {...preguntas} faqs={faqs} />

		<CtaCierre
			id={ctaCierre.id}
			titulo={ctaCierre.titulo}
			acento={ctaCierre.acento}
			texto={ctaCierre.texto}
			cta={comprar}
			ctaSecundario={{ label: ctaCierre.ctaSecundarioLabel, href: whatsappUrl() }}
		/>
	</main>

	<Footer />
</BaseLayout>
