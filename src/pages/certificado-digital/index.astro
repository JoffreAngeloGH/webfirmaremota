---
// /certificado-digital/ (specs 005, 006 y 007). Los textos viven aquí; precios, planes, requisitos, mensajes de
// WhatsApp y preguntas salen de las collections y de site.ts.
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ProductoHero from '@/components/sections/ProductoHero.astro';
import MatrizPlanes, { type FilaTitular } from '@/components/sections/MatrizPlanes.astro';
import CualNecesitas from '@/components/sections/CualNecesitas.astro';
import MediosPago from '@/components/sections/MediosPago.astro';
import Acreditacion from '@/components/sections/Acreditacion.astro';
import CredencialDigital from '@/components/illustrations/CredencialDigital.astro';
import Requisitos from '@/components/sections/Requisitos.astro';
import NecesitasLosDos from '@/components/sections/NecesitasLosDos.astro';
import ComoFunciona from '@/components/sections/ComoFunciona.astro';
import Preguntas from '@/components/sections/Preguntas.astro';
import CtaCierre from '@/components/sections/CtaCierre.astro';
import { acreditacion, comoFunciona, ctaCierre, mediosPago, necesitasLosDos, notaAtencion, preguntas } from '@/config/secciones';
import { getFaqs } from '@/lib/faqs';
import { celdasDe, vigenciasTexto } from '@/lib/planes';
import { formatPrice, notaIgv, vigenciaLabel } from '@/lib/format';
import { whatsappUrl } from '@/lib/whatsapp';
import { breadcrumbSchema, faqSchema, productSchema } from '@/lib/seo/schema';

const productos = (await getCollection('productos')).map((p) => p.data).sort((a, b) => a.orden - b.orden);
const planes = productos.flatMap((p) => (p.tipo === 'certificado' ? [p] : []));
const requisitos = (await getCollection('requisitos')).map((r) => r.data).sort((a, b) => a.orden - b.orden);
const faqs = await getFaqs('certificado-digital');

const vigencias = [...new Set(planes.map((p) => p.vigenciaAnios))].sort();
const titulares = ['natural', 'juridica'] as const;
// Textos por titular (P05): qué se puede firmar con cada certificado.
const textosTitular = {
	natural: { titulo: 'Persona natural', linea: 'Firma a tu nombre contratos, solicitudes y cualquier documento PDF, con validez legal.' },
	juridica: {
		titulo: 'Persona jurídica',
		linea: 'Firma contratos, actas y documentos legales como persona jurídica, con plena validez legal ante entidades públicas y privadas. También para personas vinculadas a una empresa.',
	},
} as const;

// Una fila por titular y una celda por vigencia. El precio por año se calcula, no se escribe.
const filas: FilaTitular[] = titulares.map((titular) => ({
	id: `persona-${titular}`,
	...textosTitular[titular],
	enlace: { label: `Ver detalles de ${textosTitular[titular].titulo.toLowerCase()} →`, href: `/certificado-digital/persona-${titular}/` },
	planes: celdasDe(planes, titular, vigencias),
}));

const desde = planes.reduce((min, p) => (p.precio < min.precio ? p : min));
const description =
	`Certificado digital para firma remota, persona natural o jurídica, de ${vigenciasTexto(vigencias)} desde ${formatPrice(desde.precio, desde.moneda)}. ` +
	`Sin instalar nada. Te atiende un asesor por WhatsApp.`;

const chips = [`${titulares.length} titulares`, `${vigencias.length} vigencias`, `Desde ${formatPrice(desde.precio, desde.moneda)} ${notaIgv(desde.incluyeIgv)}`];
const migas = [{ label: 'Inicio', href: '/' }, { label: 'Certificado digital' }];
const comprar = { label: ctaCierre.ctaLabel, href: whatsappUrl() };
// Si todas las columnas de requisitos comparten la misma frase, va una sola vez bajo el título.
const introComun = requisitos.every((r) => r.intro === requisitos[0]!.intro) ? requisitos[0]!.intro : undefined;
---

<BaseLayout
	title="Certificado digital persona natural y jurídica"
	description={description}
	schema={[
		...planes.map((p) => productSchema(p, '/certificado-digital/')),
		breadcrumbSchema([{ name: 'Inicio', path: '/' }, { name: 'Certificado digital', path: '/certificado-digital/' }]),
		faqSchema(faqs.map((f) => ({ question: f.pregunta, answer: f.respuesta }))),
	]}
>
	<Header />

	<main>
		<ProductoHero
			migas={migas}
			migasLabel="Migas de pan"
			etiqueta="Certificado digital"
			titulo="Certificado digital"
			acento="para firma remota."
			subtitulo="Tu identidad digital vive en la nube: firmas con tu usuario, tu PIN y un código que llega a tu WhatsApp. Elige el titular y la vigencia."
			nota={notaAtencion}
			chips={chips}
		>
			<CredencialDigital />
		</ProductoHero>

		<CualNecesitas
			id="cual-necesitas"
			titulo="¿Cuál"
			acento="necesitas?"
			tarjetas={titulares.map((t) => ({
				titulo: textosTitular[t].titulo,
				texto: textosTitular[t].linea,
				enlace: { label: `Ver detalles de ${textosTitular[t].titulo.toLowerCase()}`, href: `/certificado-digital/persona-${t}/` },
			}))}
		/>

		<MatrizPlanes
			trasHero={false}
			id="planes"
			etiqueta="Planes"
			titulo="Elige tu"
			acento="certificado."
			intro="Mismo certificado en la nube; cambia el titular y cuánto tiempo dura."
			caption="Planes de certificado digital: precio por titular y vigencia"
			columnaTitular="Titular"
			vigencias={vigencias.map((v) => ({ label: vigenciaLabel(v), destacado: v === 2 ? 'Más elegido' : undefined }))}
			filas={filas}
			ctaLabel="Comprar"
			incluye={{
				titulo: 'Qué incluye',
				items: [
					'Certificado digital en la nube, sin instalar nada',
					'Acceso con usuario y contraseña',
					'Cada firma se confirma con tu PIN y un código por WhatsApp',
					'Un asesor te acompaña en la compra',
				],
			}}
		>
			<MediosPago {...mediosPago} medios={[...mediosPago.medios]} class="mt-8" />
		</MatrizPlanes>

		<!-- P22: logo de INDECOPI en el slot `logo` cuando llegue el archivo (specs/pendientes.md) -->
		<Acreditacion {...acreditacion} hitos={[...acreditacion.hitos]} sello={{ ...acreditacion.sello }} />

		<Requisitos
			id="requisitos"
			titulo="Lo que"
			acento="necesitas."
			intro={introComun}
			columnas={requisitos.map((r) => ({
				titulo: textosTitular[r.titular].titulo,
				icono: r.icono,
				intro: introComun ? undefined : r.intro,
				items: r.items,
			}))}
			nota="Un asesor te confirma los requisitos antes de la compra."
		/>

		<NecesitasLosDos {...necesitasLosDos} enlace={{ label: 'Ver bolsas de firmas', href: '/firmas/' }} />

		<ComoFunciona {...comoFunciona} pasos={[...comoFunciona.pasos]} />

		<Preguntas {...preguntas} faqs={faqs} />

		<CtaCierre
			id={ctaCierre.id}
			titulo={ctaCierre.titulo}
			acento={ctaCierre.acento}
			texto={ctaCierre.texto}
			cta={comprar}
			ctaSecundario={{ label: ctaCierre.ctaSecundarioLabel, href: whatsappUrl() }}
		/>
	</main>

	<Footer />
</BaseLayout>
