---
/** "Sirven con tu certificado": dos tarjetas, con el certificado nuestro o el de otro proveedor (spec 005). */
import SectionHeading from '@/components/sections/SectionHeading.astro';

interface Props {
	id: string;
	titulo: string;
	acento?: string;
	intro?: string;
	tarjetas: { titulo: string; texto: string }[];
}
const { id, titulo, acento, intro, tarjetas } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-titulo`} class="border-y border-fr-line bg-fr-paper-2">
	<div class="gs-container gs-section">
		<SectionHeading id={`${id}-titulo`} titulo={titulo} acento={acento} intro={intro} />
		<ul data-reveal="stagger" class="mt-10 grid list-none gap-6 p-0 md:grid-cols-2">
			{
				tarjetas.map((t, i) => (
					<li class="rounded-fr-card border border-fr-line bg-fr-sheet p-7 shadow-fr-sheet sm:p-8">
						<p class="fr-eyebrow m-0 text-fr-muted">0{i + 1}</p>
						<h3 class="mt-4 mb-0 text-xl font-bold tracking-tight">{t.titulo}</h3>
						<p class="mt-3 mb-0 text-fr-muted">{t.texto}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
