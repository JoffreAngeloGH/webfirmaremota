---
/**
 * "Antes de comprar" (specs 008 y 012): la garantía de devolución como casillas de días y tres casos, y los medios de
 * pago. La entrega pasó a los requisitos y el respaldo legal a la sección de respaldo. Las casillas son decorativas
 * (`aria-hidden`): el plazo ya está en el texto. No usa MediosPago.astro. Todo llega por props.
 */
import SectionHeading from '@/components/sections/SectionHeading.astro';

interface Props {
	id: string;
	etiqueta: string;
	titulo: string;
	acento?: string;
	intro?: string;
	devolucion: {
		titulo: string;
		/** Subtítulo con el plazo en texto. */
		plazo: string;
		dias: number;
		/** "Día" */
		diaLabel: string;
		/** "Ya no procede" */
		fueraDePlazo: string;
		casos: { destacado: string; texto: string }[];
		contacto: string;
		correos: string[];
		enlace: { label: string; href: string };
	};
	pagos: { titulo: string; texto: string; medios: { nombre: string; monograma: string }[] };
}
const { id, etiqueta, titulo, acento, intro, devolucion, pagos } = Astro.props;
const dias = Array.from({ length: devolucion.dias }, (_, i) => i + 1);
const tarjeta = 'rounded-fr-card border border-fr-line bg-fr-sheet p-6 shadow-fr-sheet sm:p-8';
---

<section id={id} aria-labelledby={`${id}-titulo`} class="border-y border-fr-line bg-fr-paper-2">
	<div class="gs-container gs-section">
		<SectionHeading id={`${id}-titulo`} etiqueta={etiqueta} titulo={titulo} acento={acento} intro={intro} />

		<div data-reveal="stagger" class="mt-10 grid gap-6 lg:grid-cols-[1.5fr_1fr]">
			<!-- Devolución -->
			<div class={tarjeta}>
				<h3 class="m-0 text-xl font-bold tracking-tight">{devolucion.titulo}</h3>
				<p class="mt-3 mb-0 text-fr-muted">{devolucion.plazo}</p>

				<ol aria-hidden="true" class="mt-6 mb-0 grid list-none gap-1.5 p-0 sm:gap-2" style={`grid-template-columns: repeat(${devolucion.dias + 1}, minmax(0, 1fr))`}>
					{
						dias.map((d) => (
							<li class="grid h-9 place-items-center rounded-fr-control bg-fr-navy font-fr-mono text-xs font-medium text-white sm:h-12 sm:text-sm">
								<span class="sm:hidden">{devolucion.diaLabel.charAt(0)}{d}</span>
								<span class="hidden sm:inline">{devolucion.diaLabel} {d}</span>
							</li>
						))
					}
					<li class="grid h-9 place-items-center rounded-fr-control border border-dashed border-fr-line-strong bg-[repeating-linear-gradient(135deg,transparent_0,transparent_5px,var(--color-fr-line)_5px,var(--color-fr-line)_6px)] px-1 text-center font-fr-mono text-[10px] leading-tight text-fr-muted sm:h-12 sm:text-xs">
						{devolucion.fueraDePlazo}
					</li>
				</ol>

				<ul class="mt-6 mb-0 grid list-none gap-3 p-0 sm:grid-cols-3">
					{
						devolucion.casos.map((c) => (
							<li class="rounded-fr-control border border-fr-line bg-fr-paper p-4">
								<p class="m-0 font-fr-display text-[1.7rem] leading-none font-extrabold tracking-tight text-fr-navy tabular-nums">{c.destacado}</p>
								<p class="mt-2 mb-0 text-sm text-fr-text">{c.texto}</p>
							</li>
						))
					}
				</ul>

				<p class="mt-6 mb-0 text-sm text-fr-text">
					{devolucion.contacto}{' '}
					{devolucion.correos.map((c, i) => (
						<>
							{i > 0 && ' · '}
							<a href={`mailto:${c}`} class="font-semibold text-fr-tinta underline underline-offset-4">{c}</a>
						</>
					))}
				</p>
				<a href={devolucion.enlace.href} class="mt-1 inline-flex min-h-12 items-center font-semibold text-fr-tinta underline-offset-4 hover:underline">{devolucion.enlace.label}</a>
			</div>

			<!-- Pagos -->
			<div class={tarjeta}>
				<h3 class="m-0 text-xl font-bold tracking-tight">{pagos.titulo}</h3>
				<p class="mt-3 mb-0 text-fr-muted">{pagos.texto}</p>
				<ul class="mt-6 mb-0 grid list-none grid-cols-2 gap-3 p-0">
					{
						pagos.medios.map((m) => (
							<li class="flex items-center gap-3 rounded-fr-control border border-fr-line bg-fr-paper p-2.5 text-sm font-semibold text-fr-navy">
								<span aria-hidden="true" class="grid size-[30px] shrink-0 place-items-center rounded-md bg-fr-tinta-soft font-fr-mono text-[10px] font-bold text-fr-navy">{m.monograma}</span>
								{m.nombre}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>
