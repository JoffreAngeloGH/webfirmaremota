---
/**
 * Sección de bolsas de firmas (spec 005, 006 y 007). Estructura:
 *   1) el selector (slot por defecto: la isla SelectorBolsas) en una tarjeta,
 *   2) al lado desde `lg`, el medidor de saldo (slot `medidor`) con su texto,
 *   3) debajo, la tabla de volúmenes (slot `tabla`).
 * Los textos llegan por props.
 */
import SectionHeading from '@/components/sections/SectionHeading.astro';

interface Props {
	id: string;
	titulo: string;
	acento?: string;
	intro?: string;
	/** Texto que acompaña al medidor de saldo (slot `medidor`). */
	medidor?: { titulo: string; acento?: string; texto: string };
}
const { id, titulo, acento, intro, medidor } = Astro.props;
const conMedidor = Astro.slots.has('medidor');
---

<section id={id} aria-labelledby={`${id}-titulo`} class="gs-container gs-section-tras-hero">
	<SectionHeading id={`${id}-titulo`} titulo={titulo} acento={acento} intro={intro} />

	<div class:list={['mt-10 grid gap-10', conMedidor && 'lg:grid-cols-[1.1fr_0.9fr] lg:items-start lg:gap-12']}>
		<div data-reveal class="rounded-fr-card border border-fr-line bg-fr-sheet p-7 shadow-fr-sheet sm:p-8">
			<slot />
		</div>

		{
			conMedidor && (
				<div data-reveal class="grid gap-6">
					{medidor && (
						<div>
							<h3 class="m-0 text-2xl font-bold tracking-tight">
								{medidor.titulo}{' '}
								{medidor.acento && <span class="font-fr-serif font-normal tracking-normal text-fr-navy italic">{medidor.acento}</span>}
							</h3>
							<p class="mt-3 mb-0 text-fr-muted">{medidor.texto}</p>
						</div>
					)}
					<slot name="medidor" />
				</div>
			)
		}
	</div>

	<div class="mt-10 grid gap-6">
		<slot name="tabla" />
	</div>
</section>
