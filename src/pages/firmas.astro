---
// /firmas/ (specs 005, 006 y 007). Los textos viven aquí; bolsas, precios y mensajes de WhatsApp salen de la
// collection y de site.ts.
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ProductoHero from '@/components/sections/ProductoHero.astro';
import Bolsas from '@/components/sections/Bolsas.astro';
import TablaBolsas, { type FilaBolsa } from '@/components/sections/TablaBolsas.astro';
import MediosPago from '@/components/sections/MediosPago.astro';
import SelectorBolsas, { type BolsaSelector } from '@/components/islands/SelectorBolsas';
import FichasFirmas from '@/components/illustrations/FichasFirmas.astro';
import MedidorSaldo from '@/components/illustrations/MedidorSaldo.astro';
import CompatibleCon from '@/components/sections/CompatibleCon.astro';
import NecesitasLosDos from '@/components/sections/NecesitasLosDos.astro';
import Preguntas from '@/components/sections/Preguntas.astro';
import CtaCierre from '@/components/sections/CtaCierre.astro';
import { ctaCierre, mediosPago, necesitasLosDos, notaAtencion, preguntas } from '@/config/secciones';
import { getFaqs } from '@/lib/faqs';
import { formatCantidad, formatPrice, notaIgv, notaIgvAccesible } from '@/lib/format';
import { productWhatsappUrl, whatsappUrl } from '@/lib/whatsapp';
import { breadcrumbSchema, faqSchema, firmasSchema } from '@/lib/seo/schema';

const productos = (await getCollection('productos')).map((p) => p.data).sort((a, b) => a.orden - b.orden);
const bolsas = productos
	.flatMap((p) => (p.tipo === 'firmas' ? [p] : []))
	.sort((a, b) => a.cantidad - b.cantidad);
const planes = productos.filter((p) => p.tipo === 'certificado');
const faqs = await getFaqs('firmas');

const minima = bolsas[0]!;
const masGrande = bolsas[bolsas.length - 1]!;
const masBarata = bolsas.reduce((a, b) => (b.precioUnitario < a.precioUnitario ? b : a), minima);
const baseUnitario = minima.precioUnitario;

// Ahorro frente al precio por firma de la bolsa mínima, en % entero.
const ahorroDe = (unitario: number) => Math.round((1 - unitario / baseUnitario) * 100);

const filas: FilaBolsa[] = bolsas.map((b) => ({
	id: `bolsa-${b.cantidad}`,
	cantidad: formatCantidad(b.cantidad),
	unitario: formatPrice(b.precioUnitario, b.moneda),
	total: formatPrice(b.precio, b.moneda),
	ahorro: ahorroDe(b.precioUnitario),
	nombre: b.nombre,
	href: productWhatsappUrl(b),
}));

const opciones: BolsaSelector[] = bolsas.map((b, i) => ({
	id: filas[i]!.id,
	nombre: b.nombre,
	cantidadTexto: filas[i]!.cantidad,
	total: b.precio,
	totalTexto: filas[i]!.total,
	unitarioTexto: filas[i]!.unitario,
	ahorro: filas[i]!.ahorro,
	href: filas[i]!.href,
}));

const description =
	`Bolsas de firmas para tu certificado digital, de ${formatCantidad(minima.cantidad)} a ${formatCantidad(masGrande.cantidad)} firmas, ` +
	`desde ${formatPrice(masBarata.precioUnitario, masBarata.moneda)} por firma. ` +
	`No vencen y sirven con certificados de otros proveedores. Compra por WhatsApp.`;

const chips = [
	...(bolsas.every((b) => !b.vence) ? ['No vencen'] : []),
	`De ${formatCantidad(minima.cantidad)} a ${formatCantidad(masGrande.cantidad)} firmas`,
	`Desde ${formatPrice(masBarata.precioUnitario, masBarata.moneda)} por firma ${notaIgv(masBarata.incluyeIgv)}`,
];
const comprar = { label: ctaCierre.ctaLabel, href: whatsappUrl() };
---

<BaseLayout
	title="Firmas digitales: bolsas para tu certificado"
	description={description}
	schema={[
		firmasSchema(bolsas, '/firmas/'),
		breadcrumbSchema([{ name: 'Inicio', path: '/' }, { name: 'Firmas', path: '/firmas/' }]),
		faqSchema(faqs.map((f) => ({ question: f.pregunta, answer: f.respuesta }))),
	]}
>
	<Header />

	<main>
		<ProductoHero
			migas={[{ label: 'Inicio', href: '/' }, { label: 'Firmas' }]}
			migasLabel="Migas de pan"
			etiqueta="Firmas"
			titulo="Firmas para tu"
			acento="certificado digital."
			subtitulo="Las firmas son el saldo que usas cada vez que firmas. No vencen: se descuentan a medida que las usas."
			nota={notaAtencion}
			chips={chips}
		>
			<div class="relative mx-auto w-full max-w-md lg:mx-0 lg:justify-self-end">
				<div class="absolute -inset-3 rotate-2 rounded-fr-card border border-fr-line bg-fr-paper-2" aria-hidden="true"></div>
				<FichasFirmas grande cantidad={minima.cantidad} class="relative shadow-fr-lift" />
			</div>
		</ProductoHero>

		<Bolsas
			id="bolsas"
			titulo="Bolsas de firmas"
			medidor={{
				titulo: 'Tu saldo,',
				acento: 'a la vista.',
				texto: 'Cada vez que firmas se descuenta del saldo de tu bolsa. Lo que no usas no vence.',
			}}
		>
			<SelectorBolsas
				client:visible
				etiqueta="Tu bolsa"
				leyenda="Elige cuántas firmas necesitas"
				firmasLabel="firmas"
				porFirmaLabel="por firma"
				ahorraLabel="Ahorras"
				totalLabel="Total"
				ctaLabel="Comprar"
				nota={notaAtencion}
				igv={notaIgv(minima.incluyeIgv)}
				igvSr={notaIgvAccesible(minima.incluyeIgv)}
				simbolo={formatPrice(0, minima.moneda).split(' ')[0]!}
				bolsas={opciones}
			/>
			<MedidorSaldo slot="medidor" cantidad={minima.cantidad} />
			<Fragment slot="tabla">
				<TablaBolsas
					caption="Bolsas de firmas por volumen: cantidad, precio por firma, total y ahorro"
					columnas={{ firmas: 'Firmas', porFirma: 'Precio por firma', total: `Total (${notaIgv(minima.incluyeIgv)})`, ahorro: 'Ahorro' }}
					filas={filas}
					ctaLabel="Comprar"
					ahorraLabel="Ahorras"
					sinAhorroLabel="Sin ahorro"
					firmasLabel="firmas"
				/>
				<MediosPago {...mediosPago} medios={[...mediosPago.medios]} />
			</Fragment>
		</Bolsas>

		<CompatibleCon
			id="compatible"
			titulo="Sirven con"
			acento="tu certificado."
			intro="Puedes comprarnos solo las firmas y usarlas con un certificado de otro proveedor, o comprar los dos juntos."
			tarjetas={[
				{ titulo: 'Con nuestro certificado', texto: 'Compras el certificado y las firmas, y te atiende un mismo asesor.' },
				{ titulo: 'Con otro proveedor', texto: 'Ya tienes certificado: solo sumas las firmas que necesitas.' },
			]}
		/>

		<NecesitasLosDos
			{...necesitasLosDos}
			enlace={{ label: `Ver los ${planes.length} planes`, href: '/certificado-digital/' }}
		/>

		<Preguntas {...preguntas} faqs={faqs} />

		<CtaCierre
			id={ctaCierre.id}
			titulo={ctaCierre.titulo}
			acento={ctaCierre.acento}
			texto={ctaCierre.texto}
			cta={comprar}
			ctaSecundario={{ label: ctaCierre.ctaSecundarioLabel, href: whatsappUrl() }}
		/>
	</main>

	<Footer />
</BaseLayout>
