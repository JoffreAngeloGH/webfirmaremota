---
/**
 * Normativa y respaldo (spec 008): tarjetas de lo que cubre el certificado y un enlace al registro oficial de
 * INDECOPI (ROPS). Todo llega por props.
 */
import SectionHeading from '@/components/sections/SectionHeading.astro';
import Icono from '@/components/icons/Icono.astro';
import type { NombreIcono } from '@/lib/iconos';

interface Props {
	id: string;
	titulo: string;
	acento?: string;
	intro?: string;
	tarjetas: { titulo: string; texto: string; icono: NombreIcono }[];
	enlace: { label: string; href: string };
}
const { id, titulo, acento, intro, tarjetas, enlace } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-titulo`} class="gs-container gs-section">
	<SectionHeading id={`${id}-titulo`} titulo={titulo} acento={acento} intro={intro} />
	<ul data-reveal="stagger" class="mt-10 grid list-none gap-6 p-0 md:grid-cols-2 lg:grid-cols-3">
		{
			tarjetas.map((t) => (
				<li class="flex gap-4 rounded-fr-card border border-fr-line bg-fr-sheet p-6 shadow-fr-sheet">
					<span class="grid size-12 shrink-0 place-items-center rounded-fr-control bg-fr-navy text-white">
						<Icono nombre={t.icono} class="size-6" />
					</span>
					<div>
						<h3 class="m-0 text-lg font-bold tracking-tight">{t.titulo}</h3>
						<p class="mt-2 mb-0 text-sm text-fr-muted">{t.texto}</p>
					</div>
				</li>
			))
		}
	</ul>
	<a href={enlace.href} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex min-h-12 items-center gap-2 font-semibold text-fr-tinta underline-offset-4 hover:underline">
		{enlace.label}
		<svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8" /></svg>
	</a>
</section>
