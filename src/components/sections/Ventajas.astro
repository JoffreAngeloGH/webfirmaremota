---
import SectionHeading from '@/components/sections/SectionHeading.astro';
import SinInstalar from '@/components/illustrations/SinInstalar.astro';
import Dispositivos from '@/components/illustrations/Dispositivos.astro';
import Verificacion from '@/components/illustrations/Verificacion.astro';

/** Mini-ilustraciones animadas de cada ventaja (spec 004). */
const ILUSTRACIONES = { 'sin-instalar': SinInstalar, dispositivos: Dispositivos, verificacion: Verificacion } as const;

interface Props {
	id: string;
	etiqueta: string;
	titulo: string;
	acento?: string;
	ventajas: { titulo: string; texto: string; ilustracion: keyof typeof ILUSTRACIONES }[];
	comparacion: {
		/** Título accesible de la tabla. */
		caption: string;
		columnas: [string, string];
		filas: { label: string; a: string; b: string }[];
	};
}
const { id, etiqueta, titulo, acento, ventajas, comparacion } = Astro.props;
const [colA, colB] = comparacion.columnas;
---

<section id={id} aria-labelledby={`${id}-titulo`} class="gs-container gs-section-tras-hero">
	<SectionHeading id={`${id}-titulo`} etiqueta={etiqueta} titulo={titulo} acento={acento} />

	<ul data-reveal="stagger" class="mt-12 grid list-none gap-6 p-0 md:grid-cols-3">
		{
			ventajas.map((v) => {
				const Ilustracion = ILUSTRACIONES[v.ilustracion];
				return (
				<li class="rounded-fr-card border border-fr-line bg-fr-sheet p-7 shadow-fr-sheet">
					<div class="rounded-fr-control border border-fr-line bg-fr-paper px-3 py-2">
						<Ilustracion class="block h-auto w-full" />
					</div>
					<h3 class="mt-6 mb-0 text-xl font-bold tracking-tight">{v.titulo}</h3>
					<p class="mt-2 mb-0 text-sm leading-relaxed text-fr-muted">{v.texto}</p>
				</li>
				);
			})
		}
	</ul>

	<!-- Comparación: tabla desde 768px -->
	<div data-reveal class="mt-10 hidden overflow-hidden rounded-fr-card border border-fr-line bg-fr-sheet md:block">
		<table class="w-full border-collapse text-left text-sm">
			<caption class="sr-only">{comparacion.caption}</caption>
			<thead>
				<tr class="border-b border-fr-line">
					<td class="w-1/4 p-5"></td>
					<th scope="col" class="w-[37.5%] p-5 font-fr-mono text-xs font-medium tracking-[0.14em] text-fr-muted uppercase">{colA}</th>
					<th scope="col" class="w-[37.5%] bg-fr-paper p-5 font-fr-mono text-xs font-medium tracking-[0.14em] text-fr-navy uppercase">
						<span class="inline-flex items-center gap-2"><span aria-hidden="true" class="size-1.5 rounded-full bg-fr-girasol"></span>{colB}</span>
					</th>
				</tr>
			</thead>
			<tbody>
				{
					comparacion.filas.map((f, i) => (
						<tr class:list={[i < comparacion.filas.length - 1 && 'border-b border-fr-line']}>
							<th scope="row" class="p-5 font-semibold text-fr-navy">{f.label}</th>
							<td class="p-5 text-fr-muted">{f.a}</td>
							<td class="bg-fr-paper p-5 font-medium text-fr-text">{f.b}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	<!-- Comparación: dos tarjetas en móvil -->
	<div class="mt-10 grid gap-4 md:hidden">
		{
			[
				{ titulo: colA, valores: comparacion.filas.map((f) => ({ label: f.label, v: f.a })), destacado: false },
				{ titulo: colB, valores: comparacion.filas.map((f) => ({ label: f.label, v: f.b })), destacado: true },
			].map((col) => (
				<div class:list={['rounded-fr-card border border-fr-line p-5', col.destacado ? 'bg-fr-sheet shadow-fr-sheet' : 'bg-fr-paper-2']}>
					<p class="fr-eyebrow m-0 inline-flex items-center gap-2 text-fr-navy">
						{col.destacado && <span aria-hidden="true" class="size-1.5 rounded-full bg-fr-girasol" />}
						{col.titulo}
					</p>
					<dl class="m-0 mt-4 space-y-3">
						{col.valores.map((x) => (
							<div>
								<dt class="text-xs font-semibold text-fr-navy">{x.label}</dt>
								<dd class="m-0 text-sm text-fr-muted">{x.v}</dd>
							</div>
						))}
					</dl>
				</div>
			))
		}
	</div>
</section>
