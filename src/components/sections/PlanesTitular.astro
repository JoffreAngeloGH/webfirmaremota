---
/**
 * Los 3 planes de un titular (spec 005). Cada tarjeta lleva su ancla (`id`) para poder enlazarla;
 * `data-destacable` hace que destacar.ts la centre y la resalte al llegar con el hash.
 * Los textos y los datos llegan por props.
 */
import { buttonVariants } from '@/components/ui/button';

export interface PlanTarjeta {
	/** Ancla de la tarjeta, p. ej. "juridica-2-anos". */
	id: string;
	vigencia: string;
	precio: string;
	nota?: string;
	nombre: string;
	href: string;
	/** Etiqueta discreta sobre la tarjeta (p. ej. "Más elegido"). */
	destacado?: string;
}

interface Props {
	id: string;
	titulo: string;
	intro: string;
	planes: PlanTarjeta[];
	ctaLabel: string;
	/** Fondo de la sección, para alternar entre grupos. */
	fondo?: 'paper' | 'paper-2';
}
const { id, titulo, intro, planes, ctaLabel, fondo = 'paper' } = Astro.props;
---

<section
	id={id}
	aria-labelledby={`${id}-titulo`}
	class:list={[fondo === 'paper-2' && 'border-y border-fr-line bg-fr-paper-2']}
>
	<div class="gs-container gs-section">
		<div class="max-w-2xl">
			<h2 id={`${id}-titulo`} class="m-0 text-[2rem] leading-[1.08] font-extrabold tracking-[-0.025em] md:text-[2.75rem]">
				{titulo}
			</h2>
			<p class="mt-4 mb-0 text-fr-muted md:text-lg">{intro}</p>
		</div>

		<ul data-reveal="stagger" class="mt-10 grid list-none gap-6 p-0 md:grid-cols-3">
			{
				planes.map((plan) => (
					<li
						id={plan.id}
						data-destacable
						class="fr-plan flex flex-col rounded-fr-card border border-fr-line bg-fr-sheet p-7 shadow-fr-sheet transition-[translate,box-shadow] duration-500 ease-gs-out hover:-translate-y-1 hover:shadow-fr-lift sm:p-8"
					>
						<div class="flex min-h-7 items-center justify-between gap-3">
							<h3 class="m-0 text-2xl font-bold tracking-tight">{plan.vigencia}</h3>
							{plan.destacado && (
								<span class="shrink-0 rounded-full border border-fr-line-strong bg-fr-paper px-3 py-1 font-fr-mono text-xs text-fr-navy">
									{plan.destacado}
								</span>
							)}
						</div>
						<p class="mt-6 mb-0 font-fr-display text-[2.6rem] leading-none font-extrabold tracking-tight text-fr-navy tabular-nums">
							{plan.precio}
						</p>
						{plan.nota && <p class="mt-2 mb-0 text-sm text-fr-muted">{plan.nota}</p>}
						<p class="mt-5 mb-0 font-fr-mono text-xs text-fr-muted">{plan.nombre}</p>
						<div class="min-h-8 flex-1" aria-hidden="true" />
						<a href={plan.href} target="_blank" rel="noopener noreferrer" class={buttonVariants({ className: 'w-full' })}>
							{ctaLabel}
							<span class="sr-only"> {plan.nombre}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
